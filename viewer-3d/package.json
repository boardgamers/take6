{
  "name": "take6-viewer-3d",
  "version": "0.1.0",
  "description": "A 3D (three.js) viewer for take6, playable on desktop and mobile",
  "type": "module",
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boardgamers/take6.git",
    "directory": "viewer-3d"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "prepublishOnly": "pnpm build:lib",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "events": "^3.3.0",
    "lodash": "^4.17.21",
    "take6-engine": "workspace:*",
    "three": "^0.166.0"
  },
  "devDependencies": {
    "@types/events": "^3.0.3",
    "@types/lodash": "^4.14.182",
    "@types/node": "^13.13.52",
    "@types/three": "^0.166.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "files": [
    "src",
    "dist",
    "dist-lib",
    "tsconfig.json"
  ]
}
